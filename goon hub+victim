    function TP(targetHRP)
        if not lp.Character then return end
        local HRP=lp.Character:FindFirstChild("HumanoidRootPart"); local Humanoid=lp.Character:FindFirstChild("Humanoid")
        if not HRP or not Humanoid then return end
        HRP.AssemblyLinearVelocity=Vector3.zero; HRP.AssemblyAngularVelocity=Vector3.zero
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        local predictedPos=targetHRP.Position+(targetHRP.Velocity*PredictionStrength)
        local targetCFrame=CFrame.new(predictedPos)*CFrame.Angles(0,math.rad(targetHRP.Orientation.Y),0)*CFrame.new(XOffset,YOffset,ZOffset)
        local Distance=(targetCFrame.Position-HRP.Position).Magnitude
        local hD=math.sqrt((targetCFrame.Position.X-HRP.Position.X)^2+(targetCFrame.Position.Z-HRP.Position.Z)^2)
        local vD=math.abs(targetCFrame.Position.Y-HRP.Position.Y)
        local speed=(vD>hD) and TweenSpeed.Y or TweenSpeed.X
        if ActiveTween then ActiveTween:Cancel() end
        ActiveTween=TweenService:Create(HRP,TweenInfo.new(Distance/speed,Enum.EasingStyle.Linear),{CFrame=targetCFrame})
        ActiveTween:Play()
