    local function resetAllFeatures()
        for _, setToggle in ipairs(toggleSetters) do pcall(setToggle, false) end
        for _, resetSlider in ipairs(sliderResetters) do pcall(resetSlider) end
        for key, value in pairs(defaultSettings) do
            if type(value) == "boolean" then
                tbl2[key] = value
            elseif type(value) == "number" or type(value) == "string" then
                tbl2[key] = value
            end
        end
        selectedTarget = nil
        name = nil
        victimHubRuntime2.S.SelectedPlayerName = nil
        victimHubRuntime2.S.CachedSelectedPlayer = nil
        victimHubRuntime2.S.CurrentTargetPlayer = nil
        pcall(fn18)
        pcall(fn24, false)
        pcall(fn26)
        for _, moduleState in pairs(tbl4) do
            if type(moduleState) == "table" and moduleState.Stop then pcall(moduleState.Stop) end
        end
        statsFpsEnabled, statsPingEnabled, statsCountEnabled = false, false, false
        statsGui.Enabled = false
        mainFrame.Visible = true
        mainFrame.Size = baseMainSize
        mainFrame.Position = baseMainPosition
        mainFrame.BackgroundTransparency = 0.3
        toggleButton.Position = UDim2.new(0, 100, 0, 100)
        fullbrightEnabled = false
        lighting.Brightness = originalLighting.Brightness
        lighting.ClockTime = originalLighting.ClockTime
        lighting.GlobalShadows = originalLighting.GlobalShadows
        lighting.Ambient = originalLighting.Ambient
        lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    end
    createLabel(configRightScroll, "[ Reset ]")
    local resetUiButton = createButton(configRightScroll, "Reset UI")
    resetUiButton.MouseButton1Click:Connect(resetAllFeatures)

