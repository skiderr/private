    -- The remaining category panels intentionally stay empty.
    local function refreshAllVisibleLayouts()
        for _, scroll in ipairs({homeScroll, espScroll, otherLeftScroll, otherRightScroll, bfLeftScroll, bfRightScroll, farmLeftScroll, farmRightScroll, configLeftScroll, configRightScroll}) do
            local layout = scroll:FindFirstChildOfClass("UIListLayout")
            if layout then
                scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                end)
            end
        end
    end
    task.defer(refreshAllVisibleLayouts)
    refreshAllVisibleLayouts()
    refreshPlayerList()
    Players.PlayerAdded:Connect(function()
        task.defer(refreshPlayerList)
    end)
    Players.PlayerRemoving:Connect(function(player)
        if selectedTarget == player then
            selectedTarget = nil
            name = nil
            selectPlayerBtn.Text = "Select Player"
