    -- ── Refresh Player List ───────────────────────────────────
    local function refreshPlayerList()
        for _, child in ipairs(playerDropdown:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -10, 0, 30)
                btn.Position = UDim2.new(0, 5, 0, 0)
                btn.BackgroundColor3 = Color3.fromRGB(55, 15, 75)
                btn.TextColor3 = Color3.new(1, 1, 1)
                btn.Text = p.Name
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 14
                btn.AutoButtonColor = true
                btn.Parent = playerDropdown
                btn.MouseButton1Click:Connect(function()
                    selectedTarget = p
                    local runtime = getgenv and getgenv().__VictimHubRuntime
                    if runtime and runtime.S then runtime.S.SelectedPlayerName = p.Name end
                    selectPlayerBtn.Text = "Target: " .. p.Name
                    playerDropdown.Visible = false
                end)
            end
        end
        local layout = playerDropdown:FindFirstChildOfClass("UIListLayout")
        if not layout then
            layout = Instance.new("UIListLayout")
            layout.Parent = playerDropdown
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Padding = UDim.new(0, 4)
        end
        playerDropdown.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
        playerDropdown.Visible = false
    end

    selectPlayerBtn.MouseButton1Click:Connect(function()
        playerDropdown.Visible = not playerDropdown.Visible
    end)

