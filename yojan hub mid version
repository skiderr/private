    local function refreshPlayerList()
        -- clear existing buttons
        for _, child in ipairs(playerDropdown:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 30)
                btn.BackgroundColor3 = Color3.fromRGB(55, 15, 75)
                btn.BackgroundTransparency = 0.1
                btn.TextColor3 = Color3.new(1, 1, 1)
                btn.Text = p.Name
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 14
                btn.Active = true
                btn.AutoButtonColor = true
                btn.ZIndex = 21
                btn.LayoutOrder = count
                btn.Parent = playerDropdown
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

                local function pick()
                    setSelectedPlayer(p)
                end
                btn.MouseButton1Click:Connect(pick)
                btn.Activated:Connect(pick)
            end
        end

        if count == 0 then
            local emptyLbl = Instance.new("TextLabel")
            emptyLbl.Size = UDim2.new(1, 0, 0, 30)
            emptyLbl.BackgroundTransparency = 1
            emptyLbl.Text = "No players"
            emptyLbl.TextColor3 = Color3.fromRGB(200, 150, 220)
            emptyLbl.Font = Enum.Font.GothamBold
            emptyLbl.TextSize = 13
            emptyLbl.ZIndex = 21
            emptyLbl.LayoutOrder = 1
            emptyLbl.Parent = playerDropdown
        end

        -- Force canvas size update after layout
        task.defer(function()
            local layout = playerDropdown:FindFirstChildOfClass("UIListLayout")
            if layout then
                playerDropdown.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
            end
        end)
    end

