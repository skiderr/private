-- KILL / BOUNTY TRACKING
--=============================================================
local DeathConns = {}

local function WatchPlayer(player)
    if player == LocalPlayer then return end
    if DeathConns[player] then return end

    local function hookCharacter(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 15)
            if not hum then return end
            hum.Died:Connect(function()
                SessionStats.LastVictim = {
                    Name   = player.Name,
                    UserId = player.UserId,
                    Bounty = GetPlayerBounty(player),
                    Time   = os.clock(),
                }
            end)
        end)
    end

    if player.Character then hookCharacter(player.Character) end
    DeathConns[player] = player.CharacterAdded:Connect(hookCharacter)
end

local function StartKillTracking()
    for _, p in ipairs(Players:GetPlayers()) do
        WatchPlayer(p)
    end
    Players.PlayerAdded:Connect(function(p)
        task.delay(1, function() WatchPlayer(p) end)
    end)
    Players.PlayerRemoving:Connect(function(p)
        DeathConns[p] = nil
    end)

    -- Bounty increase = kill
    task.spawn(function()
        local lastBounty = GetMyBounty()
        while true do
            task.wait(1)
            local current = GetMyBounty()
            if current > lastBounty then
                local earned = current - lastBounty
                SessionStats.Earned = SessionStats.Earned + earned
                SessionStats.Kills = SessionStats.Kills + 1

                local victim = SessionStats.LastVictim
                local fresh = victim and (os.clock() - victim.Time) < 10

                pcall(function()
                    SendKillWebhook({
                        PlayerName    = fresh and victim.Name or "Unknown",
                        UserId        = fresh and victim.UserId or "?",
                        TargetBounty  = fresh and victim.Bounty or 0,
                        Earned        = earned,
                        CurrentBounty = current,
                    })
                end)

                if fresh then
                    SessionStats.LastVictim = nil
                end
            end
            lastBounty = current
        end
    end)

    Log("Kill/bounty tracking started (Kill Webhook: %s)", tostring(CFG.NotifyKill))
end

