local function Comma(number)
    local value = tostring(math.floor(tonumber(number) or 0))
    while true do
        local newValue, count = value:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        value = newValue
        if count == 0 then break end
    end
    return value
end

local function Field(name, value, inline)
    return {
        name   = tostring(name),
        value  = tostring(value):sub(1, 1024),
        inline = inline == true,
    }
end

local function CreateEmbed(title, color)
    return {
        title     = title,
        color     = color,
        fields    = {},
        footer    = { text = CFG.WebhookName },
        timestamp = DateTime.now():ToIsoDate(),
    }
end

