local function DoServerHop()
    if Hopping then return false end
    Hopping = true

    -- 按 getgenv().hop 选择查服方式
    local useRemote = (CFG.HopMethod == "remote")
    local servers, target, playing

    if useRemote then
        servers = FetchServerListRemote()
        if not servers then
            Log("跳服[remote]: 未取到服务器列表")
            Hopping = false
            return false
        end
        target, playing = PickServerRemote(servers)
        if not target then
            _G.JumpHistory = {}
            target, playing = PickServerRemote(servers)
        end
    else
        servers = FetchServerList()
        if not servers then
            Log("跳服[api]: 未取到服务器列表")
            Hopping = false
            return false
        end
        target, playing = PickServer(servers)
        if not target then
            _G.JumpHistory = {}
            target, playing = PickServer(servers)
        end
    end

    if not target then
        Log("跳服[%s]: 没有找到可用的服务器", CFG.HopMethod)
        Hopping = false
        return false
    end

    table.insert(_G.JumpHistory, target)
    if #_G.JumpHistory > 100 then table.remove(_G.JumpHistory, 1) end

    Log("匹配到服务器[%s]: %s (人数 %s)", CFG.HopMethod, target, tostring(playing))

    -- 跳服前先收手, 避免在新服残留状态
    StopM1Loop()
    StopNoclip()
    StopFly()

    -- 跳服通知 (传送前发, 确保请求来得及完成)
    pcall(function()
        SendServerHopWebhook({
            TotalEarned   = SessionStats.Earned,
            TotalKills    = SessionStats.Kills,
            CurrentBounty = GetMyBounty(),
            Region        = "Unknown",
            Method        = tostring(CFG.HopMethod),
            Target        = target,
        })
    end)

    -- 补排一次, 保证新服里也备着 payload
    pcall(SetupAutoExec)

    local ok, method = TeleportToJob(target)
    if not ok then
        Log("跳服失败: %s", tostring(method))
        Hopping = false
        return false
    end

    Log("已发送跳服请求 (%s)", tostring(method))

    -- 重置本服统计 (新服重新计算)
    SessionStats.Kills = 0
    SessionStats.Earned = 0
    SessionStats.JoinedAt = os.clock()
    SessionStats.LastVictim = nil

    task.wait(0.5)

    Hopping = false
    return true
end

--=============================================================
-- 战斗状态判断 (取自 autobounty.lua 的 InCombat 写法)
--=============================================================
-- 主判据: PlayerGui.Main.BottomHUDList.InCombat 的可见性与文字
--   "BountyAtRisk"   战斗中且赏金受威胁 -> 绝不能跳
--   "InCombatNoRisk" 战斗中但赏金无风险 -> 可以跳
--   "NotInCombat"    不在战斗
local function GetCombatStatus()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local mainUI = pg and pg:FindFirstChild("Main")
    local bottomHUD = mainUI and mainUI:FindFirstChild("BottomHUDList")
    local inCombatUI = bottomHUD and bottomHUD:FindFirstChild("InCombat")

    if inCombatUI and inCombatUI.Visible then
        local rawText = ""
        if inCombatUI:IsA("TextLabel") then
            rawText = inCombatUI.Text
        else
            local childText = inCombatUI:FindFirstChildWhichIsA("TextLabel", true)
            if childText then rawText = childText.Text end
        end

        local lowerText = string.lower(rawText)
        if string.find(lowerText, "bounty at risk")
            or string.find(lowerText, "bounty")
            or string.find(lowerText, "賞金") then
            return "BountyAtRisk"
        else
            return "InCombatNoRisk"
        end
    end
    return "NotInCombat"
end

-- 赏金受威胁: 这时绝不能跳服, 必须等威胁解除
local function IsBountyAtRisk()
    if not CFG.NoHopInCombat then return false end
    local ok, status = pcall(GetCombatStatus)
    return ok and status == "BountyAtRisk"
end

--=============================================================
-- 跳服循环: 落地后先跑 HopInterval 秒, 然后每 HopRetryInterval 秒
-- 重试直到跳成功; 跳成功后再重新计时
-- 战斗中不跳服: 每轮检测, 战斗状态消失才继续
--=============================================================
local HopLoopStarted = false

local function StartHopLoop()
    if HopLoopStarted then return end
    HopLoopStarted = true

    task.spawn(function()
        Log("自动跳服已开启: 每轮先跑 %s 秒, 之后每 %s 秒重试一次 (查服方式: %s)",
            tostring(CFG.HopInterval), tostring(CFG.HopRetryInterval), tostring(CFG.HopMethod))

        local lastJob = game.JobId
        local combatWarned = false

        while true do
            -- 第一段: 在当前服待满 HopInterval 秒
            task.wait(CFG.HopInterval)

            -- 第二段: 反复尝试, 直到真的换到新服为止
            while game.JobId == lastJob do
                -- 战斗中绝不跳服: 等战斗状态消失再继续
                if IsBountyAtRisk() then
                    if not combatWarned then
                        combatWarned = true
                        Log("战斗中(赏金受威胁), 暂停跳服, 等战斗结束...")
                    end
                    task.wait(CFG.HopRetryInterval)
                    continue
                end

                if combatWarned then
                    combatWarned = false
                    Log("战斗已结束, 恢复跳服")
                end

                local hum = GetHum()
                local hrp = GetHRP()
                if hum and hrp and hum.Health > 0 then
                    pcall(DoServerHop)
                end
                task.wait(CFG.HopRetryInterval)
            end

            lastJob = game.JobId
            combatWarned = false
            Log("已换服, 重新计时 %s 秒", tostring(CFG.HopInterval))
        end
    end)
end

--=============================================================
-- 主体流程: 装备 -> 上飞 -> V -> M1 循环 -> 定时跳服
--=============================================================
local Initialized = false

local function RunOnce()
    Log("等待角色加载...")
    local char = GetChar()
    if not char then
        local ok = pcall(function()
            char = LocalPlayer.CharacterAdded:Wait()
        end)
        if not ok or not char then return end
    end
    task.wait(1)

    -- 1) 装备猛犸
    Log("正在装备 %s ...", CFG.FruitName)
    local mammoth = nil
    for _ = 1, 15 do
        pcall(EquipMammoth)
        mammoth = WaitForMammoth(2)
        if mammoth then break end
    end
    if mammoth then
        Log("已装备 %s", CFG.FruitName)
    else
        Log("警告: 未检测到 %s, 仍继续执行", CFG.FruitName)
    end

    -- 2) 以 300 studs/s 往上飞
    StartFly()

    -- 3) 穿墙
    if CFG.Noclip then
        StartNoclip()
    end

    -- 4) 判断是否开启猛犸, 没开启就持续按 V 直到开启
    task.wait(0.6)
    CastVUntilMammoth()

    -- 5) 循环虚空 M1
    StartM1Loop()

    -- 6) 自动 V3 / V4 (全局只保留一套循环, 换服后自动跟随新角色)
    StartAbilityLoop()

    -- 6.5) 自动武装色
    StartHakiLoop()

    -- 7) 定时跳服 (顶层自循环: 跑满间隔后每 5 秒重试直到跳成功)
    StartHopLoop()
end

local function Init()
    if Initialized then return end
    Initialized = true

    -- 同一服务器内只跑一次 (自动执行可能把脚本重灌进来)
    local env = getgenv and getgenv() or _G
    if env then
        if env.__MAMMOTH_FLY_RUNNING == game.JobId then
            Log("本服务器已初始化过, 跳过重复执行")
            return
        end
        env.__MAMMOTH_FLY_RUNNING = game.JobId
    end

    -- 加载即排队, 这样手动换服/游戏内换服也能自动重跑
    SetupAutoExec()

    -- Webhook: 启动通知 (后台发送, 不阻塞) + 击杀/赏金追踪
    task.spawn(function()
        pcall(SendStartWebhook)
    end)
    pcall(StartKillTracking)

    -- 必须最先做: 没选阵营时游戏不会生成角色, 后面所有等待角色的逻辑都会卡死
    if CFG.AutoTeam then
        Log("目标阵营: %s (来自 getgenv().Team)", tostring(CFG.Team))
        pcall(EnsureTeam)
    end

    RunOnce()
end

-- 角色重生 (含跳服换服) 后重新走一遍流程
LocalPlayer.CharacterAdded:Connect(function()
    if not Initialized then return end
    StopNoclip()
    StopFly()
    StopM1Loop()
    task.wait(2)
    task.spawn(RunOnce)
end)

Init()