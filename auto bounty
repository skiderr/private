-- 阵营可在脚本加载前用 getgenv().Team 指定, 不写则默认 Pirates:
--     getgenv().Team = "Pirates"   -- 海贼
--     getgenv().Team = "Marines"   -- 海军
--     loadstring(game:HttpGet("..."))()
local function ResolveTeam()
    local env = getgenv and getgenv() or _G
    local raw = env and env.Team

    if type(raw) == "string" and raw ~= "" then
        local lower = string.lower(raw)
        -- 容错: pirate/海贼 -> Pirates, marine/海军 -> Marines
        if string.find(lower, "marine", 1, true) or string.find(raw, "海军", 1, true) then
            return "Marines"
        end
        return "Pirates"
    end
    return "Pirates"
end

-- 查服方式可在脚本加载前用 getgenv().hop 指定, 不写则默认 api:
--     getgenv().hop = "api"      -- Roblox 公开 API (games.roblox.com)
--     getgenv().hop = "remote"   -- 游戏内 __ServerBrowser 远程
local function ResolveHop()
    local env = getgenv and getgenv() or _G
    local raw = env and env.hop

    if type(raw) == "string" then
        local lower = string.lower(raw)
        if string.find(lower, "remote", 1, true) then
            return "remote"
        end
        if string.find(lower, "api", 1, true) then
            return "api"
        end
    end
    return "api"
end

