-- 没开启猛犸就持续按 V, 直到开启为止
local function CastVUntilMammoth()
    if IsMammothOn() then
        Log("猛犸形态已开启, 跳过按V")
        return true
    end

    Log("猛犸形态未开启, 开始持续按 %s ...", CFG.SkillKey)

    local deadline = os.clock() + (CFG.TransformTimeout or 60)
    local attempt = 0

    while os.clock() < deadline do
        if IsMammothOn() then
            Log("猛犸形态已开启 (第 %d 次按 %s)", attempt, CFG.SkillKey)
            return true
        end

        attempt = attempt + 1

        -- 果实被换掉/掉了就补装备, 否则技能板不存在, 按 V 也没用
        local char = GetChar()
        local equipped = char and char:FindFirstChildOfClass("Tool")
        if not (equipped and equipped.Name == CFG.FruitName) then
            pcall(EquipMammoth)
            task.wait(0.3)
        end

        -- 释放一次 V: 优先点技能板连接, 失败再模拟按键
        local fired = false
        local cur = GetChar()
        local tool = cur and cur:FindFirstChildOfClass("Tool")
        local board = tool and GetSkillBoard(tool.Name)
        if board then
            pcall(function() fired = FireSkillByConnections(CFG.SkillKey) end)
        end
        if not fired then
            pcall(function() fired = FireSkillByKey(CFG.SkillKey) end)
        end

        -- 给变身动画留出时间, 然后复查
        task.wait(CFG.SkillRetryInterval or 1)
    end

    if IsMammothOn() then return true end
    Log("猛犸形态开启失败 (已按 %d 次 %s), 继续执行", attempt, CFG.SkillKey)
    return false
end

