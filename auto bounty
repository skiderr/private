-- 在「等待角色加载」之前就把阵营定下来.
-- 关键: 没选阵营时游戏不会生成角色, 所以必须先选阵营再去等角色, 否则会一直卡住.
local function EnsureTeam()
    if not CFG.AutoTeam then return true end

    local target = (CFG.Team == "Marines") and "Marines" or "Pirates"

    -- 先等远程就绪, 远程没好之前发什么都没用
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        local ok, result = pcall(function()
            return ReplicatedStorage:WaitForChild("Remotes", 30)
        end)
        remotes = ok and result or nil
    end
    remotes = remotes or ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF and remotes then
        local ok, result = pcall(function()
            return remotes:WaitForChild("CommF_", 30)
        end)
        commF = ok and result or nil
    end
    if not commF then
        Log("阵营设置失败: CommF_ 未就绪, 继续执行")
        return false
    end

    Log("正在加入阵营: %s ...", target)
    for i = 1, 40 do
        -- 每轮先看当前阵营, 已经对了就直接过
        local ok, team = pcall(function() return LocalPlayer.Team end)
        if ok and team and team.Name == target then
            Log("阵营已确认: %s", target)
            return true
        end

        InvokeRemote(commF, 5, "SetTeam", target)
        task.wait(1)

        local ok2, team2 = pcall(function() return LocalPlayer.Team end)
        if ok2 and team2 and team2.Name == target then
            Log("阵营已确认: %s", target)
            return true
        end

        -- 还没选阵营时, 游戏会弹阵营界面, 用点击兜底
        if i % 3 == 0 then
            pcall(JoinTeam)
        end
    end

    Log("阵营设置失败 (已重试 40 次), 继续执行")
    return false
end

