-- Detect the available HTTP request function (only one that actually exists)
local RequestFn, RequestFnName = nil, "none"
do
    local ok, fn, name = pcall(function()
        if syn and type(syn.request) == "function" then
            return syn.request, "syn.request"
        end
        if type(http_request) == "function" then
            return http_request, "http_request"
        end
        if type(request) == "function" then
            return request, "request"
        end
        if http and type(http.request) == "function" then
            return http.request, "http.request"
        end
        if fluxus and type(fluxus.request) == "function" then
            return fluxus.request, "fluxus.request"
        end
        return nil, "none"
    end)
    if ok and fn then
        RequestFn, RequestFnName = fn, name
    end
end

Log("[Webhook] HTTP request method: %s | Executor: %s", RequestFnName, ExecutorName)

-- Parse HTTP status code from the response (executors use different fields)
local function ParseStatus(response)
    if type(response) ~= "table" then return nil end
    local raw = response.StatusCode or response.status_code or response.code
    if type(raw) == "number" then return raw end
    if type(raw) == "string" then return tonumber(raw:match("(%d%d%d)")) end
    raw = response.Status
    if type(raw) == "number" then return raw end
    if type(raw) == "string" then return tonumber(raw:match("(%d%d%d)")) end
    return nil
end

-- Send via executor request function
local function SendViaRequestFn(url, body)
    if not RequestFn then return false end
    local ok, response = pcall(RequestFn, {
        Url     = url,
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = body,
    })
    if not ok then
        Log("[Webhook] %s call error: %s", RequestFnName, tostring(response))
        return false
    end
    if type(response) == "table" then
        if response.Success == true then return true end
        local status = ParseStatus(response)
        if status == 429 then
            Log("[Webhook] Rate limited by Discord (429), waiting 2 seconds")
            task.wait(2)
            return false
        end
        if status and status >= 200 and status < 300 then
            return true
        end
        Log("[Webhook] %s returned status: %s (possibly blocked or invalid URL)", RequestFnName, tostring(status or "unknown"))
        return false
    end
    -- No error but no standard response table; most executors have sent by now
    Log("[Webhook] %s returned no standard response, treating as success", RequestFnName)
    return true
end

-- Fallback: HttpService (some executors expose client HTTP)
local function SendViaHttpService(url, body)
    local ok, err = pcall(function()
        HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
    end)
    if not ok then
        Log("[Webhook] HttpService failed: %s", tostring(err))
        return false
    end
    return true
end

local LastSendAt = 0

local function SendWebhook(embed)
    if not CFG.WebhookEnabled then return false end
    if type(CFG.WebhookURL) ~= "string" or CFG.WebhookURL == "" then
        Log("[Webhook] URL not configured")
        return false
    end

    -- Discord rate limit protection: at least 2 seconds between sends
    local now = os.clock()
    if now - LastSendAt < 2 then
        task.wait(2 - (now - LastSendAt))
    end
    LastSendAt = os.clock()

    local body = HttpService:JSONEncode({
        username = CFG.WebhookName,
        embeds   = { embed },
    })

    -- Fallback domain: some executors only whitelist discordapp.com
    local urls = { CFG.WebhookURL }
    local fallback = tostring(CFG.WebhookURL):gsub("discord%.com", "discordapp.com")
    if fallback ~= CFG.WebhookURL then
        table.insert(urls, fallback)
    end

    for _, url in ipairs(urls) do
        if SendViaRequestFn(url, body) then
            Log("[Webhook] Sent successfully (%s)", RequestFnName)
            return true
        end
    end

    if SendViaHttpService(CFG.WebhookURL, body) then
        Log("[Webhook] Sent successfully (HttpService)")
        return true
    end

    Log("[Webhook] All methods failed — your executor may block the Discord API, try a different executor")
    return false
end

