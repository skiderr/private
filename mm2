-- Applies the selected/deselected look to a tab, optionally animated.
StyleTab = function(tabEntry, selected, animate)
    local btn = tabEntry and tabEntry.Btn
    if not btn then return end
    local bgGoal = selected and Theme.AccentDark or Theme.Background
    local bgTrans = selected and 0.10 or 0.45
    local textGoal = selected and Theme.Text or Theme.TextDim
    local indSize = selected and UDim2.new(0, 3, 0, 20) or UDim2.new(0, 3, 0, 0)
    local labelPos = selected and UDim2.new(0, 18, 0, 0) or UDim2.new(0, 13, 0, 0)
    if animate then
        local ti = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(btn, ti, {BackgroundColor3 = bgGoal, BackgroundTransparency = bgTrans}):Play()
        if tabEntry.Label then
            TweenService:Create(tabEntry.Label, ti, {TextColor3 = textGoal, Position = labelPos}):Play()
        end
        if tabEntry.Indicator then
            TweenService:Create(tabEntry.Indicator, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = indSize}):Play()
        end
    else
        btn.BackgroundColor3 = bgGoal
        btn.BackgroundTransparency = bgTrans
        if tabEntry.Label then
            tabEntry.Label.TextColor3 = textGoal
            tabEntry.Label.Position = labelPos
        end
        if tabEntry.Indicator then
            tabEntry.Indicator.Size = indSize
        end
    end
end

