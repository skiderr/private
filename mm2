-- ================= ANIMATED ACCENT-GRADIENT SYSTEM =================
-- Accent gradients are registered here so a single driver loop can cycle
-- their colors when an "Animated" theme (black + rainbow) is selected.
local AccentGradients = {}
local animatedHue = 0

local WhiteSequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
    ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
})

local function RainbowSequence(hue)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, 0.85, 1)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hue + 0.5) % 1, 0.85, 1)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(hue, 0.85, 1))
    })
end

-- Adds a UIGradient to `instance` and registers it for accent animation.
-- activeFn (optional): return false to skip animating (e.g. a toggle that is off).
local function MakeAccentGradient(instance, rotation, activeFn)
    local g = Instance.new("UIGradient")
    g.Rotation = rotation or 0
    g.Color = WhiteSequence
    g.Parent = instance
    table.insert(AccentGradients, {G = g, Active = activeFn})
    return g
end

-- Resets every accent gradient to plain white so solid themes show their own colors.
local function SetAccentGradientsSolid()
    for _, e in ipairs(AccentGradients) do
        if e.G and e.G.Parent then
            e.G.Color = WhiteSequence
        end
    end
end

-- Single driver loop: only animates while an Animated theme is active.
task.spawn(function()
    while true do
        if Theme and Theme.Animated then
            animatedHue = (animatedHue + 0.005) % 1
            local seq = RainbowSequence(animatedHue)
            for _, e in ipairs(AccentGradients) do
                if e.G and e.G.Parent and (e.Active == nil or e.Active()) then
                    e.G.Color = seq
                end
            end
            task.wait(0.04)
        else
            task.wait(0.4)
        end
    end
end)

