local function GetLeadShotPosition(targetRootPart)
    local currentPos = targetRootPart.Position
    if Config.LeadShot then 
        local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        currentPos = currentPos + (targetRootPart.Velocity * ping * 1.5) 
    end
    return currentPos
end

local function PerformSilentAimDirectly()
    if not Config.SilentAim then
        return false
    end
    
    local gun = nil
    
    for _, i in ipairs(LocalPlayer.Character:GetChildren()) do
        if i:IsA("Tool") and (string.find(string.lower(i.Name), "gun") or i.Name == "Revolver") then
            gun = i
            break
        end
    end
    
    if not gun then
        for _, i in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if i:IsA("Tool") and (string.find(string.lower(i.Name), "gun") or i.Name == "Revolver") then
                gun = i
                break
            end
        end
    end
    
    if not gun then
        return false
    end
    
    local targetPlr = nil
    for plrName, role in pairs(RoleCache) do
        if role == "Murderer" then
            targetPlr = Players:FindFirstChild(plrName)
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                break
            else
                targetPlr = nil
            end
        end
    end
    
    -- Role detection (RoleCache) is authoritative for the Murderer, so no
    -- knife-holder fallback is needed here.
    if not targetPlr or not targetPlr.Character or not targetPlr.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local wasInBackpack = (gun.Parent == LocalPlayer.Backpack)
    if wasInBackpack then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        task.wait(0.1)
    end
    
    local targetRoot = targetPlr.Character.HumanoidRootPart
    local targetPos = GetLeadShotPosition(targetRoot)
    
    local args = {CFrame.new(Camera.CFrame.Position, targetPos), CFrame.new(targetPos)}
    
    if gun:FindFirstChild("Shoot") then
        gun.Shoot:FireServer(unpack(args))
        
        if wasInBackpack and gun.Parent == LocalPlayer.Character then
            gun.Parent = LocalPlayer.Backpack
        end
        return true
    end
    
    return false
end

local function getGunTarget()
    if not Config.GunSilentAim then return nil end
    
    local myRole = RoleCache[LocalPlayer.Name]
    if myRole ~= "Sheriff" and myRole ~= "Hero" then
        return nil
    end
    
    for plrName, role in pairs(RoleCache) do
        if role == "Murderer" then
            local plr = Players:FindFirstChild(plrName)
            if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local humanoidrootpart = plr.Character.HumanoidRootPart
                local humanoid = plr.Character:FindFirstChild("Humanoid")
                
                if humanoidrootpart and humanoid and humanoid.Health > 0 then
                    return humanoidrootpart
                end
            end
        end
    end
    
    return nil
end

local function hasKnife(player)
    if not player or not player.Character then return false end
    
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("knife") or name:find("fac") or name == "knife" or name == "murder knife" then
                return true
            end
        end
    end
    
    for _, item in pairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("knife") or name:find("fac") or name == "knife" or name == "murder knife" then
                return true
            end
        end
    end
    
    return false
end

local function detectMurder()
    while true do
        task.wait(1)
        
        local foundMurder = nil
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and hasKnife(player) then
                foundMurder = player
                break
            end
        end
        
        murder = foundMurder
    end
end

local function getdirection(origin, position)
    return (position - origin).Unit
end

-- Knife target: closest player by 3D distance (NOT camera POV). For the
-- Murderer every other player is a valid enemy, so we simply pick the nearest
-- alive player and let the throw rewrite aim at them.
local function getclosestplayer()
    if not Config.KnifeSilentAim then return nil end
    if not knifeEquipped then return nil end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closestpart = nil
    local closestdistance = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoidrootpart = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChild("Humanoid")

            if humanoidrootpart and humanoid and humanoid.Health > 0 then
                local distance = (humanoidrootpart.Position - myRoot.Position).Magnitude

                if distance < closestdistance then
                    closestdistance = distance
                    closestpart = humanoidrootpart
                end
            end
        end
    end

    return closestpart
end

local function hookKnifeThrown()
    -- Knife-throw silent aim is handled centrally in the __namecall "KnifeThrown"
    -- FireServer branch (closest-by-distance target + optional ping prediction).
    -- This stub keeps the equip-time call sites valid and avoids double-rewriting
    -- the throw arguments through an instance-level FireServer override.
    return
end

-- ============================================================
-- WALL PIERCE (Sheriff/Hero): makes a normal manual shot kill the
-- Murderer through walls. Two cooperating hooks (proven in testing):
--   1) WeaponService.GetMouseTargetCFrame / GetTargetPosition return the
--      Murderer's head CFrame so the shot's HIT lands on them through walls.
--   2) The gun's "Shoot" remote origin argument is relocated beside the
--      Murderer's head (wallbang) so the server's line-of-sight check passes.
-- ============================================================
local pierceTorso = nil
local pierceWbOrigin = nil
local pierceCamPos = Vector3.new()
-- Per-frame predicted aim points (precomputed so the __namecall hook never makes
-- nested method calls). .gun = Murderer root (Sheriff/Hero), .knife = closest
-- player root (Murderer), .pierce = lead-predicted torso for Wall Pierce.
local aimPredict = {gun = nil, knife = nil}

local function LocalHasGun()
    local function scan(container)
        if not container then return false end
        for _, i in ipairs(container:GetChildren()) do
            if i:IsA("Tool") and (string.find(string.lower(i.Name), "gun") or i.Name == "Revolver") then
                return true
            end
        end
        return false
    end
    return scan(LocalPlayer.Character) or scan(LocalPlayer.Backpack)
end

local function GetPierceTorso()
    if not Config.WallPierce then return nil end
    local myRole = RoleCache[LocalPlayer.Name]
    local eligible = (myRole == "Sheriff" or myRole == "Hero") or LocalHasGun()
    if not eligible then return nil end
    for plrName, role in pairs(RoleCache) do
        if role == "Murderer" then
            local plr = Players:FindFirstChild(plrName)
            if plr and plr ~= LocalPlayer and plr.Character then
                -- Target the torso (HumanoidRootPart): a ~3x larger hit window than
                -- the head, so lead-prediction error on a moving Murderer still
                -- connects. Any part is a one-shot kill in MM2.
                local torso = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum   = plr.Character:FindFirstChild("Humanoid")
                if torso and hum and hum.Health > 0 then
                    return torso
                end
            end
        end
    end
    -- Role detection is authoritative; no knife-holder fallback.
    return nil
end

-- NOTE: We deliberately do NOT override WeaponService.GetMouseTargetCFrame /
-- GetTargetPosition. Returning the far Murderer's head there trips the game's
-- own client-side range check and disables the gun. The pierce is done entirely
-- in the "Shoot" remote hook below (client aims/fires normally, we swap the
-- origin + hit arguments server-side).

local oldnamecall
oldnamecall = hookmetamethod(game, "__namecall", function(...)
    local method = getnamecallmethod()
    local arguments = {...}
    local self = arguments[1]

    if not checkcaller() then
        -- KNIFE (Murderer) - throw redirect. MM2 derives the throw from a long
        -- client raycast, so we bend that ray toward the closest player (by
        -- distance, not camera POV). Surgical: only long weapon-like rays are
        -- touched and the original length is preserved, so the camera's short
        -- collision rays (Popper) are never altered (the old "buggy camera" cause).
        if self == workspace and method == "Raycast" and Config.KnifeSilentAim and knifeEquipped and aimPredict.knife then
            local origin = arguments[2]
            local dirArg = arguments[3]
            if typeof(origin) == "Vector3" and typeof(dirArg) == "Vector3" and dirArg.Magnitude > 25 then
                arguments[3] = getdirection(origin, aimPredict.knife) * dirArg.Magnitude
                return oldnamecall(unpack(arguments))
            end
        end

        if method == "FireServer" and typeof(self) == "Instance" then
            -- GUN (Sheriff/Hero). Classify each CFrame arg: the one nearest the
            -- camera is the ORIGIN, every other CFrame is a HIT point. Tolerant to
            -- arg index/count -- the old fixed index 2/3 assumption missed whenever
            -- the game packed the CFrames elsewhere (why pierce only hit "sometimes").
            if self.Name == "Shoot" then
                if Config.WallPierce and pierceTorso and pierceWbOrigin and aimPredict.pierce then
                    -- Wall Pierce: origin -> wallbang beside the lead-predicted torso
                    -- (defeats the server LOS check); hit -> the predicted torso so a
                    -- MOVING Murderer is still killed through walls.
                    local originIdx, bestD = nil, math.huge
                    for i = 2, #arguments do
                        if typeof(arguments[i]) == "CFrame" then
                            local d = (arguments[i].Position - pierceCamPos).Magnitude
                            if d < bestD then bestD = d; originIdx = i end
                        end
                    end
                    for i = 2, #arguments do
                        if typeof(arguments[i]) == "CFrame" then
                            if i == originIdx then
                                arguments[i] = CFrame.new(pierceWbOrigin, aimPredict.pierce)
                            else
                                arguments[i] = CFrame.new(aimPredict.pierce)
                            end
                        end
                    end
                elseif Config.GunSilentAim and aimPredict.gun then
                    -- Silent Aim: keep the real origin, force the hit onto the
                    -- predicted Murderer position regardless of camera POV.
                    local originIdx, bestD = nil, math.huge
                    for i = 2, #arguments do
                        if typeof(arguments[i]) == "CFrame" then
                            local d = (arguments[i].Position - pierceCamPos).Magnitude
                            if d < bestD then bestD = d; originIdx = i end
                        end
                    end
                    for i = 2, #arguments do
                        if typeof(arguments[i]) == "CFrame" and i ~= originIdx then
                            arguments[i] = CFrame.new(aimPredict.gun)
                        end
                    end
                end
                return oldnamecall(unpack(arguments))
            end

            -- KNIFE (Murderer) - if the throw is delivered as a remote CFrame,
            -- re-aim it too (each CFrame keeps its own origin = the thrower).
            if self.Name == "KnifeThrown" then
                if Config.KnifeSilentAim and aimPredict.knife then
                    for i = 2, #arguments do
                        if typeof(arguments[i]) == "CFrame" then
                            local o = arguments[i].Position
                            arguments[i] = CFrame.new(o, aimPredict.knife)
                        end
                    end
                end
                return oldnamecall(unpack(arguments))
            end
        end
    end

    return oldnamecall(...)
end)

-- Precompute the wallbang origin each frame so the FireServer branch above
-- never makes nested method calls (which would clobber getnamecallmethod()).
RunService.Heartbeat:Connect(function()
    pierceCamPos = Camera.CFrame.Position
    if Config.WallPierce then
        pierceTorso = GetPierceTorso()
        if pierceTorso then
            -- ACCURACY FIX (the reason it only hit "sometimes"): estimate the
            -- Murderer's velocity from per-frame POSITION DELTAS, not
            -- pierceTorso.Velocity. A remote character's .Velocity reads ~0 on our
            -- client (their motion arrives as replicated position updates, not local
            -- physics), so the old velocity*ping lead was ALWAYS ~0 -> we aimed at the
            -- lagging client position and missed every moving Murderer. Stationary
            -- targets still hit (no lead needed), which is exactly the intermittent
            -- failure pattern. Delta tracking gives a real velocity so the lead lands.
            local now = tick()
            local curPos = pierceTorso.Position
            if aimPredict.piercePart ~= pierceTorso then
                -- (Re)acquired target: seed the tracker; no lead on the first frame.
                aimPredict.piercePart = pierceTorso
                aimPredict.pierceEstVel = Vector3.zero
                aimPredict.pierceLastPos = curPos
                aimPredict.pierceLastTime = now
            else
                local dt = now - (aimPredict.pierceLastTime or now)
                if dt > 0.0005 then
                    local inst = (curPos - (aimPredict.pierceLastPos or curPos)) / dt
                    -- Clamp absurd one-frame spikes (teleport / jitter) so a single bad
                    -- sample can't throw the prediction across the map.
                    if inst.Magnitude > 250 then inst = inst.Unit * 250 end
                    aimPredict.pierceEstVel = (aimPredict.pierceEstVel or Vector3.zero):Lerp(inst, 0.5)
                end
                aimPredict.pierceLastPos = curPos
                aimPredict.pierceLastTime = now
            end

            local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
            local estVel = aimPredict.pierceEstVel or Vector3.zero
            aimPredict.pierce = curPos + (estVel * ping * ((Config.PierceLeadPct or 100) / 100))
            local predictedCF = pierceTorso.CFrame - pierceTorso.Position + aimPredict.pierce
            pierceWbOrigin = (predictedCF * CFrame.new(0, 0, 1)).p
        else
            aimPredict.pierce = nil
            aimPredict.piercePart = nil
        end
    else
        pierceTorso = nil
        pierceWbOrigin = nil
        aimPredict.pierce = nil
        aimPredict.piercePart = nil
    end
end)

local function PerformGrabGun()
    PlayClickSound()

    local function pullToSelf(gunDrop)
        if gunDrop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local Root = LocalPlayer.Character.HumanoidRootPart
            gunDrop.CanCollide = false
            gunDrop.CFrame = Root.CFrame + Vector3.new(0, 0, -2)
            gunDrop.Velocity = Vector3.new(0,0,0)
            return true
        end
        return false
    end

    -- 1) Gun already dropped on the ground -> pull it straight to us.
    local gunDrop = Workspace:FindFirstChild("GunDrop", true)
    if gunDrop and pullToSelf(gunDrop) then
        YojanNotify("GRAB GUN", "Grabbed the dropped gun!", 2)
        return true
    end

    -- 2) Someone is still carrying it -> fling that player (lethally, so they drop
    --    the gun) then auto-grab the drop. GunHolderFlingAndGrab is a global defined
    --    after StartFling so it can drive the fling engine.
    local function scan(container)
        if not container then return false end
        for _, i in ipairs(container:GetChildren()) do
            if i:IsA("Tool") and (string.find(string.lower(i.Name), "gun") or i.Name == "Revolver") then
                return true
            end
        end
        return false
    end

    local holder
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (scan(plr.Character) or scan(plr.Backpack)) then
            holder = plr
            break
        end
    end

    if holder then
        GunHolderFlingAndGrab(holder)
        return true
    end

    YojanNotify("GRAB GUN", "No dropped gun and nobody is holding it.", 3)
    return false
end

local function GetKeyCodeFromString(keyString)
    return keyCodes[keyString] or Enum.KeyCode[keyString]
end

local function SetupGamepadControls()
    for _, conn in pairs(gamepadConnections) do
        conn:Disconnect()
    end
    gamepadConnections = {}
    
    if Config.InputDevice and Config.InputDevice ~= "Off" then
        local silentAimKey = GetKeyCodeFromString(Config.SilentAimKey)
        if silentAimKey then
            local connBegan = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not gameProcessed and input.KeyCode == silentAimKey then
                    isRTPressed = true
                    lastRTInputTime = tick()
                    rtHoldDuration = 0
                    
                    if Config.SilentAim then
                        PerformSilentAimDirectly()
                    end
                end
            end)
            
            local connEnded = UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if not gameProcessed and input.KeyCode == silentAimKey then
                    isRTPressed = false
                    rtHoldDuration = 0
                end
            end)
            
            table.insert(gamepadConnections, connBegan)
            table.insert(gamepadConnections, connEnded)
        end
        
        local invisibleKey = GetKeyCodeFromString(Config.InvisibleKey)
        if invisibleKey then
            local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not gameProcessed and input.KeyCode == invisibleKey then
                    ToggleInvis()
                end
            end)
            table.insert(gamepadConnections, conn)
        end
        
        local grabGunKey = GetKeyCodeFromString(Config.GrabGunKey)
        if grabGunKey then
            local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not gameProcessed and input.KeyCode == grabGunKey then
                    PerformGrabGun()
                end
            end)
            table.insert(gamepadConnections, conn)
        end
        
        task.spawn(function()
            while Config.InputDevice and Config.InputDevice ~= "Off" do
                if isRTPressed and Config.SilentAim then
                    local currentTime = tick()
                    rtHoldDuration = currentTime - lastRTInputTime
                    
                    if rtHoldDuration > 0.3 then
                        PerformSilentAimDirectly()
                        lastRTInputTime = currentTime
                    end
                end
                task.wait(0.05)
            end
        end)
        
        gamepadActive = true
    else
        gamepadActive = false
        isRTPressed = false
    end
end

