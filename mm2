        local count = 0
        for _, d in ipairs(map:GetDescendants()) do
            if d:IsA("BasePart") then
                sum = sum + d.Position
                count = count + 1
            end
        end
        if count > 0 then
            targetPos = sum / count
        end
    end
    if targetPos then
        char:PivotTo(CFrame.new(targetPos + Vector3.new(0, 5, 0)))
        YojanNotify("TELEPORT", "Teleported to game map.", 2)
    end
end)
