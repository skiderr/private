    KeyBtn.Position = UDim2.new(1, -102, 0.5, -11)
    KeyBtn.BackgroundColor3 = Theme.InputBG
    KeyBtn.BorderSizePixel = 0
    KeyBtn.Text = tostring(defaultVal)
    KeyBtn.TextColor3 = Theme.Accent
    KeyBtn.Font = Enum.Font.GothamBold
    KeyBtn.TextSize = 11
    KeyBtn.AutoButtonColor = false
    KeyBtn.Parent = KeybindFrame
    AddCorner(KeyBtn, 5)
    local KeyStroke = AddStroke(KeyBtn, Theme.Accent, 1)
    MakeAccentGradient(KeyStroke, 0)
    
    if field then
        KeybindUI[field] = KeyBtn
    end
    
    local listening = false
    local prevText = tostring(defaultVal)
    
    local function stopListen()
        listening = false
        KeyBtn.TextColor3 = Theme.Accent
        KeyStroke.Color = Theme.Accent
    end
    
    KeyBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        listening = true
        prevText = KeyBtn.Text
        KeyBtn.Text = "..."
        KeyBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
        KeyStroke.Color = Color3.fromRGB(255, 90, 90)
    end)
    
    local connection
    connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not listening then return end
        local keyName = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
        if keyName == "Escape" then
            KeyBtn.Text = prevText
            stopListen()
            return
        end
        if gameProcessed then return end
        local device = Config.InputDevice or "Keyboard"
        local accept
        if device == "Gamepad" then
            accept = IsGamepadKey(keyName)
        else
            accept = (input.UserInputType == Enum.UserInputType.Keyboard) and keyName ~= "Unknown"
        end
        if accept then
            KeyBtn.Text = keyName
            stopListen()
            if callback then callback(keyName) end
        else
            YojanNotify("KEYBIND", device == "Gamepad" and "Please use a gamepad button!" or "Please use a keyboard key!", 2)
        end
    end)
    
    task.delay(15, function()
        if listening then
            KeyBtn.Text = prevText
            stopListen()
        end
    end)
    
    table.insert(themedComponents, function()
        KeybindFrame.BackgroundColor3 = Theme.ItemBG
        kbGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Lighten(Theme.ItemBG, 0.05)), ColorSequenceKeypoint.new(1, Darken(Theme.ItemBG, 0.10))}
        kbStroke.Color = Lighten(Theme.ItemBG, 0.12)
        Label.TextColor3 = Theme.Text
        KeyBtn.BackgroundColor3 = Theme.InputBG
        if not listening then
            KeyBtn.TextColor3 = Theme.Accent
            KeyStroke.Color = Theme.Accent
        end
    end)
end

-- Expanding selection menu (glass styled) used for the input-device picker.
function CreateDropdown(parent, text, options, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -10, 0, 34)
    Frame.BackgroundColor3 = Theme.ItemBG
    Frame.BackgroundTransparency = 0.25
    Frame.BorderSizePixel = 0
    Frame.ClipsDescendants = true
    Frame.Parent = parent
    AddCorner(Frame, 9)
    local ddGrad = AddGradient(Frame, Lighten(Theme.ItemBG, 0.05), Darken(Theme.ItemBG, 0.10), 90)
    local ddStroke = AddStroke(Frame, Lighten(Theme.ItemBG, 0.12), 1)
    
    local Header = Instance.new("TextButton")
    Header.Size = UDim2.new(1, 0, 0, 34)
    Header.BackgroundTransparency = 1
    Header.Text = ""
    Header.AutoButtonColor = false
    Header.Parent = Frame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.5, -4, 1, 0)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Theme.Text
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextTruncate = Enum.TextTruncate.AtEnd
    Label.Parent = Header
    
    local Value = Instance.new("TextLabel")
    Value.Size = UDim2.new(0.5, -16, 1, 0)
    Value.Position = UDim2.new(0.5, 4, 0, 0)
    Value.BackgroundTransparency = 1
    Value.Text = tostring(defaultVal) .. "  v"
    Value.TextColor3 = Theme.Accent
    Value.Font = Enum.Font.GothamBold
    Value.TextSize = 11
    Value.TextXAlignment = Enum.TextXAlignment.Right
    Value.TextTruncate = Enum.TextTruncate.AtEnd
    Value.Parent = Header
    
    local OptionsHolder = Instance.new("Frame")
    OptionsHolder.Size = UDim2.new(1, -12, 0, 0)
    OptionsHolder.Position = UDim2.new(0, 6, 0, 36)
    OptionsHolder.BackgroundTransparency = 1
    OptionsHolder.Parent = Frame
    local optLayout = Instance.new("UIListLayout")
    optLayout.Padding = UDim.new(0, 3)
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Parent = OptionsHolder
    
    local current = defaultVal
    local open = false
    local optionButtons = {}
    local OPT_H = 24
    
    local function refreshColors()
        for o, b in pairs(optionButtons) do
            b.TextColor3 = (o == current) and Theme.Accent or Theme.TextDim
        end
    end
    
    local function setOpen(state)
        open = state
        local targetH = state and (38 + #options * (OPT_H + 3)) or 34
        TweenService:Create(Frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, -10, 0, targetH)}):Play()
        Value.Text = tostring(current) .. (state and "  ^" or "  v")
    end
    
    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size = UDim2.new(1, 0, 0, OPT_H)
        ob.BackgroundColor3 = Theme.InputBG
        ob.BackgroundTransparency = 0.15
        ob.BorderSizePixel = 0
        ob.Text = opt
        ob.TextColor3 = (opt == current) and Theme.Accent or Theme.TextDim
        ob.Font = Enum.Font.GothamSemibold
        ob.TextSize = 11
        ob.AutoButtonColor = false
        ob.Parent = OptionsHolder
        AddCorner(ob, 5)
        optionButtons[opt] = ob
        ob.MouseButton1Click:Connect(function()
            PlayClickSound()
            current = opt
            refreshColors()
            setOpen(false)
            if callback then callback(opt) end
        end)
    end
    
    Header.MouseButton1Click:Connect(function()
        PlayClickSound()
        setOpen(not open)
    end)
    Header.MouseEnter:Connect(function()
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = Lighten(Theme.ItemBG, 0.10)}):Play()
    end)
    Header.MouseLeave:Connect(function()
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = Theme.ItemBG}):Play()
    end)
    
    table.insert(themedComponents, function()
        Frame.BackgroundColor3 = Theme.ItemBG
        ddGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Lighten(Theme.ItemBG, 0.05)), ColorSequenceKeypoint.new(1, Darken(Theme.ItemBG, 0.10))}
        ddStroke.Color = Lighten(Theme.ItemBG, 0.12)
        Label.TextColor3 = Theme.Text
        Value.TextColor3 = Theme.Accent
        for _, b in pairs(optionButtons) do
            b.BackgroundColor3 = Theme.InputBG
        end
        refreshColors()
    end)
    
    return function(newVal)
        current = newVal
        Value.Text = tostring(current) .. (open and "  ^" or "  v")
        refreshColors()
    end
end

