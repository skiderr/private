-- Fling engine: faithful port of rayz.txt's fling (u140 / u529 / v530). We pin our
-- own linear velocity with a BodyVelocity (Velocity=0, MaxForce=9e9) so we never get
-- launched, then rapidly re-place our whole character onto the target's LIVE position
-- with alternating +/-1.5-stud vertical offsets and a spinning angle, slamming huge
-- Velocity + RotVelocity onto our root each time. That insane in-place spin, repeated
-- many times per second against the target, is what blasts them -- and because we
-- re-read their position on EVERY placement it tracks moving players. Runs for 2s or
-- until the fling is stopped. The lethal flag (grab-gun) skips fall protection so the
-- target falls out of the map, dies and drops the gun.
local function FlingPlayer(targetPlayer)
    flingInProgress = true

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = targetPlayer and targetPlayer.Character
    if not (Character and Humanoid and RootPart and TCharacter) then
        flingInProgress = false
        return
    end

    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")
    local anchorPos = RootPart.CFrame

    if RootPart.Velocity.Magnitude < 50 then
        getgenv().OldPos = RootPart.CFrame
    end

    -- rayz: a seated target can't be flung reliably, so bail out.
    if THumanoid and THumanoid.Sit then
        flingInProgress = false
        return
    end

    if THead then
        workspace.CurrentCamera.CameraSubject = THead
    elseif not Handle then
        if THumanoid and TRootPart then
            workspace.CurrentCamera.CameraSubject = THumanoid
        end
    else
        workspace.CurrentCamera.CameraSubject = Handle
    end

    if not TCharacter:FindFirstChildWhichIsA("BasePart") then
        workspace.CurrentCamera.CameraSubject = Humanoid
        flingInProgress = false
        return
    end

    -- rayz u529: put our root (and whole character) on the target part's CURRENT
    -- position with the given offset/angle, then slam huge linear + angular velocity.
    local function place(part, offsetCF, angleCF)
        if not (RootPart and RootPart.Parent and part and part.Parent) then return end
        local cf = CFrame.new(part.Position) * offsetCF * angleCF
        RootPart.CFrame = cf
        Character:SetPrimaryPartCFrame(cf)
        RootPart.Velocity = Vector3.new(90000000, 900000000, 90000000)
        RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
    end

    -- rayz v530: the spin loop, as a repeat...until so a full placement cycle ALWAYS
    -- runs at least once (a plain `while flingActive` could skip everything if the flag
    -- flips early). The target's live position is re-read on every place() call.
    local function spin(part)
        local timestamp = tick()
        local angle = 0
        repeat
            if RootPart and RootPart.Parent and THumanoid and part and part.Parent then
                if part.Velocity.Magnitude < 50 then
                    angle = angle + 100
                    place(part, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * part.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * part.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * part.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * part.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                else
                    place(part, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    place(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                end
            else
                task.wait()
            end
        until tick() > timestamp + 2 or not flingActive
    end

    if getgenv().FPDH == nil then
        getgenv().FPDH = workspace.FallenPartsDestroyHeight
    end
    -- Non-lethal fling protects falling parts so the target survives (just launched).
    -- Lethal fling (grab-gun) leaves the destroy height alone so the target falls out
    -- of the map, dies and drops the gun.
    if not getgenv().YojanFlingLethal then
        workspace.FallenPartsDestroyHeight = 0 / 0
    end

    -- Make sure SetPrimaryPartCFrame works: some characters ship with no PrimaryPart,
    -- which would error inside place() and abort the spin (again leaving only the
    -- camera on the target). rayz relies on this being set.
    if Character.PrimaryPart ~= RootPart then
        Character.PrimaryPart = RootPart
    end

    -- rayz's linear-velocity pin: Velocity=0 with huge MaxForce keeps US anchored
    -- while the RotVelocity spin launches the target. Published to getgenv() so the
    -- cancel paths (StopFling / ResetFlingState) can destroy it if we're killed.
    local bv = Instance.new("BodyVelocity")
    bv.Name = "YojanFlingBodyVelocity"
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(9000000000, 9000000000, 9000000000)
    bv.Parent = RootPart
    getgenv().YojanFlingBV = bv

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    if not TRootPart then
        if THead then
            spin(THead)
        elseif Handle then
            spin(Handle)
        end
    else
        spin(TRootPart)
    end

    -- Cleanup: drop the pin and kill our momentum.
    if bv then bv:Destroy() end
    getgenv().YojanFlingBV = nil
    if RootPart and RootPart.Parent then
        RootPart.Velocity = Vector3.new(0, 0, 0)
        RootPart.RotVelocity = Vector3.new(0, 0, 0)
    end
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = Humanoid

    -- rayz walks us back to where we started (OldPos) and forces a get-up. Fall back to
    -- the anchor captured at entry if OldPos was never set (we were moving too fast).
    if getgenv().OldPos then
        pcall(function()
            repeat
                RootPart.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
                Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
                Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                for _, child in pairs(Character:GetChildren()) do
                    if child:IsA("BasePart") then
                        child.Velocity = Vector3.new()
                        child.RotVelocity = Vector3.new()
                    end
                end
                task.wait()
            until (RootPart.Position - getgenv().OldPos.p).Magnitude < 25
        end)
    elseif RootPart and RootPart.Parent then
        RootPart.CFrame = anchorPos
    end

    workspace.FallenPartsDestroyHeight = getgenv().FPDH
    flingInProgress = false
end

local function FlingAllLoop()
    flingInProgress = true
    local players = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(players, plr)
        end
    end
    if #players == 0 then flingInProgress = false return end

    local index = 1
    while flingAllActive do
        local target = players[index]
        if target and target.Character and target.Character:FindFirstChild("Humanoid") and target.Character.Humanoid.Health > 0 then
            flingActive = true
            flingTargetPlayer = target
            FlingPlayer(target)
            flingActive = false
        end
        index = index % #players + 1
        task.wait(0.5)
    end
    flingInProgress = false
end

-- Fling reads and writes our real RootPart CFrame + velocity. Desync (fake
-- position) and Anti Silent Aim (spoofs CFrame via hookmetamethod) both corrupt
-- that, so fling can't work while either is active. Returns true (and warns the
-- user which feature(s) to disable) when a fling should be blocked.
local function FlingConflictWarning()
    local blocking = {}
    if desync_on then
        table.insert(blocking, "Desync")
    end
    if Config.AntiSilentAim then
        table.insert(blocking, "Anti Silent Aim")
    end
    if #blocking > 0 then
        YojanNotify("FLING", "Turn off " .. table.concat(blocking, " and ") .. " before using Fling.", 4)
        return true
    end
    return false
end

local function StartFling(targetRoleOrPlayer)
    if flingInProgress then
        YojanNotify("FLING", "Please wait, a fling is already in progress!", 3)
        return
    end

    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end
    flingActive = false
    flingAllActive = false

    if targetRoleOrPlayer == "all" then
        flingAllActive = true
        flingThread = task.spawn(FlingAllLoop)
    else
        local targetPlayer
        if type(targetRoleOrPlayer) == "string" then
            for plrName, role in pairs(RoleCache) do
                if role == targetRoleOrPlayer then
                    targetPlayer = Players:FindFirstChild(plrName)
                    break
                end
            end
        else
            targetPlayer = targetRoleOrPlayer
        end
        if targetPlayer then
            flingActive = true
            flingTargetPlayer = targetPlayer
            flingThread = task.spawn(function()
                FlingPlayer(targetPlayer)
                -- One-shot fling finished: clear the role toggle state so the button
                -- un-sticks from its "flinged" (checkmark) look and can be fired again
                -- right away, instead of needing a second press to reset the mode.
                if flingTargetPlayer == targetPlayer then
                    flingActive = false
                    flingTargetPlayer = nil
                end
                Config.FlingSheriff = false
                Config.FlingMurderer = false
                Config.FlingHero = false
                if RefreshRoleFlingButtons then RefreshRoleFlingButtons() end
            end)
        end
    end
end

local function StopFling()
    flingActive = false
    flingAllActive = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end
    Config.FlingSheriff = false
    Config.FlingMurderer = false
    Config.FlingHero = false
    Config.FlingAll = false
    flingInProgress = false
    getgenv().YojanFlingLethal = false
    -- A cancelled fling never runs its own cleanup, so restore collision + destroy
    -- height here (otherwise other players stay non-colliding / parts never reset).
    if getgenv().YojanFlingCollision then
        for part, val in pairs(getgenv().YojanFlingCollision) do
            if part and part.Parent then part.CanCollide = val end
        end
        getgenv().YojanFlingCollision = nil
    end
    if getgenv().FPDH ~= nil then
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end
    -- A cancelled fling never runs its own cleanup, so destroy the BodyVelocity pin
    -- here (otherwise it stays on our root forever and freezes our movement).
    if getgenv().YojanFlingBV then
        pcall(function() getgenv().YojanFlingBV:Destroy() end)
        getgenv().YojanFlingBV = nil
    end
    -- A cancelled fling never runs its own camera restore, so do it here to avoid
    -- leaving CameraSubject stuck on a target (which causes stray zoom/jitter later,
    -- e.g. when equipping the gun/knife).
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if cam and hum then
        cam.CameraSubject = hum
    end
    if hum then
        hum.PlatformStand = false
    end
end

-- Dying (or respawning for a new round) mid-fling used to leave flingInProgress
-- stuck true ("something in queue" forever) and CameraSubject stuck on the
-- target (camera feels like it's inside a box + gun shows the wall X marker).
-- Clean the whole fling state on death / respawn so every round starts fresh.
local function ResetFlingState()
    flingActive = false
    flingAllActive = false
    flingInProgress = false
    flingTargetPlayer = nil
    getgenv().YojanFlingLethal = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end
    Config.FlingSheriff = false
    Config.FlingMurderer = false
    Config.FlingHero = false
    Config.FlingAll = false
    if getgenv().YojanFlingCollision then
        for part, val in pairs(getgenv().YojanFlingCollision) do
            if part and part.Parent then part.CanCollide = val end
        end
        getgenv().YojanFlingCollision = nil
    end
    if getgenv().FPDH ~= nil then
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end
    -- Destroy any leaked BodyVelocity pin from a fling cancelled mid-loop by death/respawn.
    if getgenv().YojanFlingBV then
        pcall(function() getgenv().YojanFlingBV:Destroy() end)
        getgenv().YojanFlingBV = nil
    end
    do
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    if RefreshRoleFlingButtons then RefreshRoleFlingButtons() end
end

-- Grab-gun helper (global so PerformGrabGun -- defined earlier -- can call it).
-- Flings whoever is carrying the gun LETHALLY so they fall out of the map and drop
-- it, then polls for the GunDrop and pulls it to us automatically. Re-flings if the
-- holder somehow survives the first launch.
function GunHolderFlingAndGrab(holder)
    if flingInProgress then
        YojanNotify("GRAB GUN", "Wait for the current fling to finish.", 3)
        return
    end
    if FlingConflictWarning() then return end
    if not (holder and holder.Character) then
        YojanNotify("GRAB GUN", "Gun holder is no longer valid.", 3)
        return
    end

    YojanNotify("GRAB GUN", "Flinging the gun holder...", 3)
    task.spawn(function()
        getgenv().YojanFlingLethal = true
        StartFling(holder)

        local endTime = tick() + 8
        local nextFling = tick() + 2.5
        local grabbed = false
        while tick() < endTime do
            task.wait(0.2)
            local drop = Workspace:FindFirstChild("GunDrop", true)
            if drop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local Root = LocalPlayer.Character.HumanoidRootPart
                drop.CanCollide = false
                drop.CFrame = Root.CFrame + Vector3.new(0, 0, -2)
                drop.Velocity = Vector3.new(0,0,0)
                grabbed = true
                break
            end
            if tick() >= nextFling and not flingInProgress and holder.Character then
                nextFling = tick() + 2.5
                getgenv().YojanFlingLethal = true
                StartFling(holder)
            end
        end

        StopFling()
        getgenv().YojanFlingLethal = false
        if grabbed then
            YojanNotify("GRAB GUN", "Gun grabbed!", 2)
        else
            YojanNotify("GRAB GUN", "Holder flung, but no gun dropped.", 3)
        end
    end)
end

