    Track.BackgroundColor3 = default and Theme.Accent or TOGGLE_OFF
    Track.BorderSizePixel = 0
    Track.Parent = ToggleFrame
    AddCorner(Track, 10)
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.AnchorPoint = Vector2.new(0, 0.5)
    Knob.Position = default and UDim2.new(0, 20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.Parent = Track
    AddCorner(Knob, 8)
    
    local toggled = default and true or false
    local trackGrad = MakeAccentGradient(Track, 0, function() return toggled end)
    
    local function render(animate)
        local trackColor = toggled and Theme.Accent or TOGGLE_OFF
        local knobPos = toggled and UDim2.new(0, 20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        -- Keep the rainbow only while ON in an animated theme; otherwise plain white
        if not (toggled and Theme.Animated) then
            trackGrad.Color = ColorSequence.new(Color3.new(1, 1, 1))
        end
        if animate then
            TweenService:Create(Track, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = trackColor}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = knobPos}):Play()
        else
            Track.BackgroundColor3 = trackColor
            Knob.Position = knobPos
        end
    end
    
    ToggleBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        toggled = not toggled
        render(true)
        callback(toggled)
    end)
    
    ToggleBtn.MouseEnter:Connect(function()
        TweenService:Create(ToggleFrame, TweenInfo.new(0.18), {BackgroundColor3 = Lighten(Theme.ItemBG, 0.10)}):Play()
    end)
    ToggleBtn.MouseLeave:Connect(function()
        TweenService:Create(ToggleFrame, TweenInfo.new(0.18), {BackgroundColor3 = Theme.ItemBG}):Play()
    end)
    
    table.insert(themedComponents, function()
        ToggleFrame.BackgroundColor3 = Theme.ItemBG
        frameGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Lighten(Theme.ItemBG, 0.05)), ColorSequenceKeypoint.new(1, Darken(Theme.ItemBG, 0.10))}
        frameStroke.Color = Lighten(Theme.ItemBG, 0.12)
        Label.TextColor3 = Theme.Text
        Track.BackgroundColor3 = toggled and Theme.Accent or TOGGLE_OFF
    end)
    
    return function(state)
        toggled = state and true or false
        render(false)
    end
end

