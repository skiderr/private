-- X-ray: make all world parts (except our own character) see-through locally.
function ApplyXRay(on)
    for _, d in pairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") and (not LocalPlayer.Character or not d:IsDescendantOf(LocalPlayer.Character)) then
            d.LocalTransparencyModifier = on and 0.7 or 0
        end
    end
end

