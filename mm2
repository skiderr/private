-- Adds a two-stop UIGradient used for the frosted-glass sheen on panels.
local function AddGradient(instance, topColor, bottomColor, rotation, transparency)
    local gradient = Instance.new("UIGradient")
    gradient.Rotation = rotation or 90
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, topColor),
        ColorSequenceKeypoint.new(1, bottomColor)
    }
    if transparency then
        gradient.Transparency = transparency
    end
    gradient.Parent = instance
    return gradient
end

-- Lightens a Color3 toward white by a given ratio (used for glass highlights).
local function Lighten(color, ratio)
    return color:Lerp(Color3.new(1, 1, 1), ratio or 0.08)
end

-- Darkens a Color3 toward black by a given ratio (used for glass depth).
local function Darken(color, ratio)
    return color:Lerp(Color3.new(0, 0, 0), ratio or 0.25)
end

