-- Full-frame drag for floating on-screen buttons: a 6px threshold separates a
-- drag (reposition) from a tap (activate), and Config.LockButtons freezes them.
local function MakeButtonDraggable(frame, button)
    local dragging, dragInput, dragStart, startPos
    local THRESHOLD = 6
    button.Active = true
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            button:SetAttribute("Dragged", false)
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput and not Config.LockButtons then
            local delta = input.Position - dragStart
            if delta.Magnitude > THRESHOLD then
                button:SetAttribute("Dragged", true)
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)
end

-- Wraps a floating button action so it is suppressed immediately after a drag.
local function ButtonClickGuard(button, fn)
