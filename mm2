local function SV_Lighten(color, ratio)
	return color:Lerp(Color3.new(1, 1, 1), ratio or 0.08)
end
local function SV_Darken(color, ratio)
	return color:Lerp(Color3.new(0, 0, 0), ratio or 0.25)
end

-- Frosted-glass sheen gradient used on panels.
local function SV_Glass(instance, topColor, bottomColor, rotation)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation or 90
	g.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, topColor),
		ColorSequenceKeypoint.new(1, bottomColor)
	}
	g.Parent = instance
	return g
end

-- Animated rainbow accent system (mirrors Yojan Hub's Gradient theme).
local SV_WhiteSequence = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
	ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
})
local function SV_Rainbow(hue)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, 0.85, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hue + 0.5) % 1, 0.85, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(hue, 0.85, 1))
	})
end
local SV_AccentGradients = {}
local SV_Hue = 0
local function SV_MakeAccent(instance, rotation, activeFn)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation or 0
	g.Color = SV_WhiteSequence
	g.Parent = instance
	table.insert(SV_AccentGradients, {G = g, Active = activeFn})
	return g
end
task.spawn(function()
	while true do
		SV_Hue = (SV_Hue + 0.005) % 1
		local seq = SV_Rainbow(SV_Hue)
		for i = #SV_AccentGradients, 1, -1 do
			local e = SV_AccentGradients[i]
			if e and e.G and e.G.Parent then
				if e.Active == nil or e.Active() then
					e.G.Color = seq
				else
					e.G.Color = SV_WhiteSequence
				end
			else
				table.remove(SV_AccentGradients, i)
			end
		end
		task.wait(0.04)
	end
end)

