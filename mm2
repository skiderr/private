    Fill.Size = UDim2.new(0, 0, 1, 0)
    Fill.BackgroundColor3 = Theme.Accent
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 2
    Fill.Parent = Track
    AddCorner(Fill, 3)
    MakeAccentGradient(Fill, 0)
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new(0, 0, 0.5, 0)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 3
    Knob.Parent = Track
    AddCorner(Knob, 7)
    local knobStroke = AddStroke(Knob, Theme.Accent, 1.5)
    MakeAccentGradient(knobStroke, 0)
    
    local intOnly = (math.floor(min) == min and math.floor(max) == max)
    local value = math.clamp(tonumber(defaultVal) or min, min, max)
    
    local function updateVisual()
        local ratio = (max > min) and (value - min) / (max - min) or 0
        Fill.Size = UDim2.new(ratio, 0, 1, 0)
        Knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        ValueLabel.Text = intOnly and tostring(math.floor(value + 0.5)) or string.format("%.1f", value)
    end
    
    local dragging = false
    local function fromX(x)
        local trackWidth = Track.AbsoluteSize.X
        if trackWidth <= 0 then return end
        local ratio = math.clamp((x - Track.AbsolutePosition.X) / trackWidth, 0, 1)
        local newValue = min + (max - min) * ratio
        if intOnly then newValue = math.floor(newValue + 0.5) end
        if newValue ~= value then
            value = newValue
            updateVisual()
            callback(value)
        end
    end
    
    Track.MouseButton1Down:Connect(function(input)
        dragging = true
        PlayClickSound()
        fromX(input.Position.X)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    updateVisual()
    
    table.insert(themedComponents, function()
        SliderFrame.BackgroundColor3 = Theme.ItemBG
        sliderGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Lighten(Theme.ItemBG, 0.05)), ColorSequenceKeypoint.new(1, Darken(Theme.ItemBG, 0.10))}
        sliderStroke.Color = Lighten(Theme.ItemBG, 0.12)
        Label.TextColor3 = Theme.Text
        ValueLabel.TextColor3 = Theme.Accent
        Track.BackgroundColor3 = Darken(Theme.ItemBG, 0.40)
        Fill.BackgroundColor3 = Theme.Accent
        knobStroke.Color = Theme.Accent
    end)
    
    return function(newValue)
        value = math.clamp(tonumber(newValue) or min, min, max)
        updateVisual()
    end
end

