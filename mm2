-- YARHM 1:1 anti-fling: (1) detect + neutralize other flingers, and (2)
-- protect ourselves by zeroing velocity and snapping back to the last safe
-- position when we get launched.
RunService.Heartbeat:Connect(function()
    if not Config.AntiFling then return end
    -- Don't fight our OWN fling. While we're intentionally spinning at ~9e8 velocity to
    -- launch someone, the self-protection below would snap us back to antiFlingLastPos
    -- every frame (the exact "only the camera reaches the target, they never fling"
    -- symptom), and the "neutralize other flingers" half would zero the target we're
    -- launching. Pause anti-fling for the duration of our own fling.
    if flingActive or flingInProgress then return end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:IsDescendantOf(workspace) then
            local prim = plr.Character.PrimaryPart or plr.Character:FindFirstChild("HumanoidRootPart")
            if prim and (prim.AssemblyAngularVelocity.Magnitude > 50 or prim.AssemblyLinearVelocity.Magnitude > 100) then
                if not antiFlingDetected[plr.Name] then
                    antiFlingDetected[plr.Name] = true
                    YojanNotify("ANTI-FLING", "Flinger detected: " .. plr.Name, 3)
                end
                for _, p in pairs(plr.Character:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = false
                        p.AssemblyAngularVelocity = Vector3.zero
                        p.AssemblyLinearVelocity = Vector3.zero
                        p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0)
                    end
                end
            end
        end
    end

    local myChar = LocalPlayer.Character
    local myPrim = myChar and (myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart"))
    if myPrim then
        if myPrim.AssemblyLinearVelocity.Magnitude > 250 or myPrim.AssemblyAngularVelocity.Magnitude > 250 then
            myPrim.AssemblyLinearVelocity = Vector3.zero
            myPrim.AssemblyAngularVelocity = Vector3.zero
            if antiFlingLastPos ~= Vector3.zero then
                myPrim.CFrame = CFrame.new(antiFlingLastPos)
            end
        else
            antiFlingLastPos = myPrim.Position
        end
    end
end)

